# Example environment configuration
REACT_APP_STORAGE_PREFIX=maxisign_dev_
REACT_APP_VERSION=$npm_package_version

# Adobe API configuration (replace with your own keys)
REACT_APP_ADOBE_API_KEY=your_api_key_here
REACT_APP_ADOBE_CLIENT_ID=your_client_id_here

# Feature flags
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_ERROR_REPORTING=false
REACT_APP_ENABLE_SERVICE_WORKER=false

# Cache configuration
REACT_APP_CACHE_MAX_AGE=2592000
REACT_APP_CACHE_VERSION=1

# Performance settings
REACT_APP_MAX_DOCUMENT_SIZE=10485760
REACT_APP_MAX_IMAGE_SIZE=5242880
REACT_APP_COMPRESSION_QUALITY=0.8
